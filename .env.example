# 复制为 .env 后填写本地运行需要的变量
# 不要把真实 .env、真实 API Key、访问码或其他 Secret 提交到代码仓库。

# 真实图片生成 Key：只允许放在本地环境变量、.env 或公司批准的 Secret 管理位置。
OPENAI_API_KEY=sk-your-api-key-here

# 可选：多 OpenAI API 项目服务端路由。未设置 OPENAI_PROVIDER_ORDER 时，
# 服务保持上方 OPENAI_API_KEY 的单键兼容行为；设置后只使用列出的 provider，
# 不会回退到 OPENAI_API_KEY。provider ID 仅可使用小写字母、数字和下划线。
# OPENAI_PROVIDER_ORDER=primary,secondary
# OPENAI_PROVIDER_PRIMARY_API_KEY=sk-your-api-key-here-primary
# OPENAI_PROVIDER_PRIMARY_ENABLED=true
# OPENAI_PROVIDER_PRIMARY_MAX_REQUESTS=0
# OPENAI_PROVIDER_PRIMARY_COOLDOWN_MS=60000
# OPENAI_PROVIDER_SECONDARY_API_KEY=sk-your-api-key-here-secondary
# OPENAI_PROVIDER_SECONDARY_ENABLED=true
# OPENAI_PROVIDER_SECONDARY_MAX_REQUESTS=0
# OPENAI_PROVIDER_SECONDARY_COOLDOWN_MS=60000
#
# 按 ORDER 从左到右优先。只有上游明确返回 HTTP 429 或 5xx 才切换下一 provider；
# 网络超时、连接中断等结果不透明的失败不会切换，以避免重复出图收费。
# MAX_REQUESTS=0 表示本次进程运行期间不设请求总量上限；请求计数和熔断状态均仅保存在内存，重启后清零。

# 内部访问码：用于最小内部访问控制；请替换为负责人提供的非公开访问码。
INTERNAL_ACCESS_CODE=replace-with-internal-access-code

# 可选：没有真实 Key 时，只演示前后端流程并返回本地占位图片
DEMO_IMAGE_MODE=false

# 可选：非敏感运行状态记录目录，默认 data/
DATA_DIR=data

# 可选：批量生成输出目录，默认 outputs/
OUTPUTS_DIR=outputs

# 可选：批量安全上限，避免过量调用和重复扣费
BATCH_MAX_MATERIALS=10
BATCH_MAX_OUTPUTS=30
BATCH_MAX_PER_MATERIAL=4
BATCH_MAX_PROMPT_CHARS=4000
BATCH_MAX_IMAGE_BYTES=8388608
BATCH_MAX_REQUEST_BYTES=36700160

# 可选：服务端口
PORT=3000
